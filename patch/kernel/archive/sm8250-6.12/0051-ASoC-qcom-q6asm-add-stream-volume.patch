+/**
+ * q6asm_set_volume() - set the ASM stream (soft volume) gain
+ *
+ * @ac: audio client pointer
+ * @q13_gain: linear gain in Q13 (0x2000 == 1.0 == 0 dB)
+ *
+ * Programs the ASM "Volume Control" post-processing module
+ * (ASM_MODULE_ID_VOL_CTRL / ASM_PARAM_ID_VOL_CTRL_MASTER_GAIN, i.e.
+ * SOFT_VOLUME_INSTANCE_1) of the given session.  This is the ASM *stream*
+ * gain stage that mainline never sets; the ADM COPP master gain can only
+ * attenuate, so this is where the playback loudness headroom comes from.
+ *
+ * Return: Will be an negative on error or a zero on success.
+ */
+int q6asm_set_volume(struct audio_client *ac, uint16_t q13_gain)
+{
+	struct asm_stream_cmd_set_pp_params *set;
+	struct asm_volume_ctrl_master_gain vol;
+	struct apr_pkt *pkt;
+	bool instance_id;
+	u32 param_size;
+	int pkt_size, rc;
+	void *p;
+
+	if (!ac)
+		return -EINVAL;
+
+	/*
+	 * Use the instance-ID capable V3 command unless the ASM service
+	 * reports an API version that predates instance IDs.
+	 */
+	instance_id = !(ac->q6asm->ainfo.api_version &&
+			ac->q6asm->ainfo.api_version <
+				ASM_API_VERSION_INSTANCE_ID);
+
+	param_size = (instance_id ? sizeof(struct asm_param_hdr_v3) :
+				    sizeof(struct asm_param_hdr_v1)) +
+		     sizeof(vol);
+	pkt_size = APR_HDR_SIZE + sizeof(*set) + param_size;
+
+	p = kzalloc(pkt_size, GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+
+	pkt = p;
+	set = p + APR_HDR_SIZE;
+
+	q6asm_add_hdr(ac, &pkt->hdr, pkt_size, true,
+		      ASM_PLAYBACK_STREAM_ID);
+	pkt->hdr.opcode = instance_id ? ASM_STREAM_CMD_SET_PP_PARAMS_V3 :
+					ASM_STREAM_CMD_SET_PP_PARAMS_V2;
+
+	vol.master_gain = q13_gain;
+	vol.reserved = 0;
+
+	/* mem_hdr stays zeroed: the parameter data is in-band */
+	set->payload_size = param_size;
+
+	if (instance_id) {
+		struct asm_param_hdr_v3 *h = (void *)set->param_data;
+
+		h->module_id = ASM_MODULE_ID_VOL_CTRL;
+		h->instance_id = ASM_INSTANCE_ID_0;
+		h->param_id = ASM_PARAM_ID_VOL_CTRL_MASTER_GAIN;
+		h->param_size = sizeof(vol);
+		memcpy(set->param_data + sizeof(*h), &vol, sizeof(vol));
+	} else {
+		struct asm_param_hdr_v1 *h = (void *)set->param_data;
+
+		h->module_id = ASM_MODULE_ID_VOL_CTRL;
+		h->param_id = ASM_PARAM_ID_VOL_CTRL_MASTER_GAIN;
+		h->param_size = sizeof(vol);
+		memcpy(set->param_data + sizeof(*h), &vol, sizeof(vol));
+	}
+
+	rc = q6asm_ac_send_cmd_sync(ac, pkt);
+	if (rc)
+		dev_err(ac->dev, "Failed to set ASM volume 0x%x, err %d\n",
+			q13_gain, rc);
+
+	kfree(pkt);
+	return rc;
+}
+EXPORT_SYMBOL_GPL(q6asm_set_volume);
