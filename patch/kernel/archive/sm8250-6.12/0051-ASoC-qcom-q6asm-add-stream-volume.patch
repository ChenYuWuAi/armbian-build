 #define ASM_DATA_CMD_REMOVE_INITIAL_SILENCE	0x00010D67
 #define ASM_DATA_CMD_REMOVE_TRAILING_SILENCE	0x00010D68
 
+/*
+ * ASM stream "set post-processing parameters" (in-band).
+ *
+ * V3 carries an instance ID in the parameter header (param_hdr_v3), V2 uses
+ * param_hdr_v1.  The parameter payload is identical to the ADM COPP volume
+ * control (AUDPROC/ASM module 0x00010BFE, parameter 0x00010BFF), which is
+ * exactly what SOFT_VOLUME_INSTANCE_1 maps to downstream.
+ */
+#define ASM_STREAM_CMD_SET_PP_PARAMS_V2		0x00010DA1
+#define ASM_STREAM_CMD_SET_PP_PARAMS_V3		0x0001320D
+
+#define ASM_MODULE_ID_VOL_CTRL			0x00010BFE
+#define ASM_PARAM_ID_VOL_CTRL_MASTER_GAIN	0x00010BFF
+#define ASM_INSTANCE_ID_0			0x0000
+
+/* ASM service API version that introduced instance IDs (param_hdr_v3) */
+#define ASM_API_VERSION_INSTANCE_ID		3
+
+/* The DSP expects the playback stream id from 1 (see q6asm-dai.c) */
+#define ASM_PLAYBACK_STREAM_ID			1
+
+/* 1.0 (0 dB) in Q13, the format the ADSP volume module expects */
+#define ASM_VOLUME_0DB_Q13			0x2000
 
 #define ASM_LEGACY_STREAM_SESSION	0
 /* Bit shift for the stream_perf_mode subfield. */
@@ -238,6 +261,46 @@ struct asm_session_cmd_run_v2 {
 	u32 time_msw;
 } __packed;
 
+/*
+ * In-band ASM SET_PP_PARAMS command.  mem_hdr stays zeroed for in-band data
+ * and the packed parameter header + payload follow payload_size.  The layout
+ * matches the downstream struct asm_stream_cmd_set_pp_params.
+ */
+struct asm_mem_mapping_hdr {
+	u32 data_payload_addr_lsw;
+	u32 data_payload_addr_msw;
+	u32 mem_map_handle;
+} __packed;
+
+struct asm_stream_cmd_set_pp_params {
+	struct asm_mem_mapping_hdr mem_hdr;
+	u32 payload_size;
+	u8 param_data[];
+} __packed;
+
+/* param_hdr_v1: no instance ID (ASM_STREAM_CMD_SET_PP_PARAMS_V2) */
+struct asm_param_hdr_v1 {
+	u32 module_id;
+	u32 param_id;
+	u16 param_size;
+	u16 reserved;
+} __packed;
+
+/* param_hdr_v3: with instance ID (ASM_STREAM_CMD_SET_PP_PARAMS_V3) */
+struct asm_param_hdr_v3 {
+	u32 module_id;
+	u16 instance_id;
+	u16 reserved;
+	u32 param_id;
+	u32 param_size;
+} __packed;
+
+/* Payload of ASM_PARAM_ID_VOL_CTRL_MASTER_GAIN: linear gain in Q13 */
+struct asm_volume_ctrl_master_gain {
+	u16 master_gain;
+	u16 reserved;
+} __packed;
