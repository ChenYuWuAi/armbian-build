+/*
+ * COPP master gain control.
+ *
+ * Userspace passes a linear Q27 value (0x08000000 == 1.0 == 0 dB), which is
+ * forwarded to q6adm_set_volume() for every COPP currently mapped to the
+ * session.  The value is cached in the session so a COPP that is opened
+ * later (or re-opened) can be programmed when the stream starts.
+ */
+static int msm_routing_get_copp_volume(struct snd_kcontrol *kcontrol,
+				       struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *c = snd_soc_kcontrol_component(kcontrol);
+	struct msm_routing_data *priv = dev_get_drvdata(c->dev);
+	struct soc_mixer_control *mc =
+		(struct soc_mixer_control *)kcontrol->private_value;
+	int session_id = mc->shift;
+
+	if (session_id < 0 || session_id >= MAX_SESSIONS)
+		return -EINVAL;
+
+	ucontrol->value.integer.value[0] = priv->sessions[session_id].volume;
+
+	return 0;
+}
+
+static int msm_routing_put_copp_volume(struct snd_kcontrol *kcontrol,
+				       struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *c = snd_soc_kcontrol_component(kcontrol);
+	struct msm_routing_data *priv = dev_get_drvdata(c->dev);
+	struct soc_mixer_control *mc =
+		(struct soc_mixer_control *)kcontrol->private_value;
+	struct session_data *session = &priv->sessions[mc->shift];
+	unsigned long copp_map;
+	int copp_idx, ret = 0;
+	int volume;
+
+	volume = clamp_t(int, ucontrol->value.integer.value[0],
+			 0, Q6ADM_VOLUME_MAX_Q27);
+
+	mutex_lock(&priv->lock);
+	copp_map = session->copp_map;
+	for_each_set_bit(copp_idx, &copp_map, MAX_COPPS_PER_PORT) {
+		ret = q6adm_set_volume(priv->dev, session->port_id, copp_idx,
+				       volume);
+		if (ret)
+			break;
+	}
+
+	if (!ret)
+		session->volume = volume;
+	mutex_unlock(&priv->lock);
+
+	return ret ? ret : 1;
+}
+
