+/**
+ * q6adm_add_topologies() - map a topology blob and send ADM_CMD_ADD_TOPOLOGIES
+ * @adm_dev: the ADM apr_device (dev_get_drvdata must be struct q6adm)
+ * @fw:      topology definition blob (elish: 5444 bytes from the ACDB)
+ * @len:     blob length
+ *
+ * ADD_TOPOLOGIES is out-of-band, so the blob is first copied into a
+ * DMA-coherent buffer and mapped into the ADSP; the resulting handle is then
+ * referenced by the command.
+ */
+int q6adm_add_topologies(struct device *adm_dev, const void *fw, size_t len)
+{
+	struct q6adm *adm = dev_get_drvdata(adm_dev);
+	struct avs_cmd_shared_mem_map_regions *cmd;
+	struct avs_shared_map_region_payload *mregions;
+	struct cmd_set_topologies *topo;
+	struct apr_pkt *pkt;
+	size_t buf_sz;
+	int pkt_size, rc = 0;
+	void *p;
+
+	if (!adm || !fw || !len)
+		return -EINVAL;
+
+	mutex_lock(&adm->topo_lock);
+
+	buf_sz = ALIGN(len, 4096);
+	adm->topo_buf = dma_alloc_coherent(adm->dev, buf_sz, &adm->topo_dma,
+					   GFP_KERNEL);
+	if (!adm->topo_buf) {
+		rc = -ENOMEM;
+		goto out;
+	}
+	memcpy(adm->topo_buf, fw, len);
+
+	/* 1) map the payload buffer into the ADSP */
+	pkt_size = APR_HDR_SIZE + sizeof(*cmd) + sizeof(*mregions);
+	p = kzalloc(pkt_size, GFP_KERNEL);
+	if (!p) {
+		rc = -ENOMEM;
+		goto out;
+	}
+	pkt = p;
+	cmd = p + APR_HDR_SIZE;
+	mregions = p + APR_HDR_SIZE + sizeof(*cmd);
+
+	pkt->hdr.hdr_field = APR_SEQ_CMD_HDR_FIELD;
+	pkt->hdr.pkt_size = pkt_size;
+	pkt->hdr.src_port = 0;
+	pkt->hdr.dest_port = 0;
+	pkt->hdr.token = 0;
+	pkt->hdr.opcode = ADM_CMD_SHARED_MEM_MAP_REGIONS;
+
+	cmd->mem_pool_id = ADM_ELISH_MAP_POOL;
+	cmd->num_regions = 1;
+	cmd->property_flag = 0;
+
+	mregions->shm_addr_lsw = lower_32_bits(adm->topo_dma);
+	mregions->shm_addr_msw = upper_32_bits(adm->topo_dma);
+	mregions->mem_size_bytes = buf_sz;
+
+	adm->topo_map_done = false;
+	adm->topo_handle = 0;
+	rc = apr_send_pkt(adm->apr, pkt);
+	kfree(p);
+	if (rc < 0) {
+		dev_err(adm->dev, "elish: map regions send failed %d\n", rc);
+		goto out;
+	}
+	if (!wait_event_timeout(adm->topo_wait, adm->topo_map_done, 5 * HZ)) {
+		dev_err(adm->dev, "elish: map regions timeout\n");
+		rc = -ETIMEDOUT;
+		goto out;
+	}
+	dev_info(adm->dev, "elish: topologies mapped (handle=0x%x, %zu bytes)\n",
+		 adm->topo_handle, buf_sz);
+
+	/* 2) add the topologies */
+	topo = kzalloc(sizeof(*topo), GFP_KERNEL);
+	if (!topo) {
+		rc = -ENOMEM;
+		goto out;
+	}
+	topo->hdr.hdr_field = APR_SEQ_CMD_HDR_FIELD;
+	topo->hdr.pkt_size = sizeof(*topo);
+	topo->hdr.src_port = 0;
+	topo->hdr.dest_port = 0;
+	topo->hdr.token = 0;
+	topo->hdr.opcode = ADM_CMD_ADD_TOPOLOGIES;
+	topo->payload_addr_lsw = lower_32_bits(adm->topo_dma);
+	topo->payload_addr_msw = upper_32_bits(adm->topo_dma);
+	topo->mem_map_handle = adm->topo_handle;
+	topo->payload_size = len;
+
+	adm->topo_add_done = false;
+	adm->topo_status = 0;
+	rc = apr_send_pkt(adm->apr, (struct apr_pkt *)topo);
+	kfree(topo);
+	if (rc < 0) {
+		dev_err(adm->dev, "elish: add topologies send failed %d\n", rc);
+		goto out;
+	}
+	if (!wait_event_timeout(adm->topo_wait, adm->topo_add_done, 5 * HZ)) {
+		dev_err(adm->dev, "elish: add topologies timeout\n");
+		rc = -ETIMEDOUT;
+		goto out;
+	}
+	if (adm->topo_status) {
+		dev_err(adm->dev, "elish: DSP rejected ADD_TOPOLOGIES, status=0x%x\n",
+			adm->topo_status);
+		rc = -EINVAL;
+		goto out;
+	}
+	dev_info(adm->dev, "elish: ADD_TOPOLOGIES ok (%zu bytes)\n", len);
+
+out:
+	mutex_unlock(&adm->topo_lock);
+	return rc;
+}
+EXPORT_SYMBOL_GPL(q6adm_add_topologies);
+
+/* elish: at ADM probe, push /lib/firmware/elish_topologies.bin if present.
+ * Absent file is normal on every other board. */
+static void q6adm_topo_work(struct work_struct *work)
+{
+	struct q6adm *adm = container_of(work, struct q6adm, topo_work.work);
+	const struct firmware *fw;
+	int rc;
+
+	rc = request_firmware(&fw, "elish_topologies.bin", adm->dev);
+	if (rc) {
+		dev_info(adm->dev, "elish: no elish_topologies.bin (%d), skipping\n",
+			 rc);
+		return;
+	}
+	rc = q6adm_add_topologies(adm->dev, fw->data, fw->size);
+	release_firmware(fw);
+	if (rc)
+		dev_err(adm->dev, "elish: add topologies failed %d\n", rc);
+}
